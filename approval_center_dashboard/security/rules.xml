<odoo>
    <record id="rule_request_users" model="ir.rule">
        <field name="name">Approval requests assigned to user or requested by user</field>
        <field name="model_id" ref="model_approval_center_request"/>
        <field name="domain_force">['|', ('approver_ids', 'in', [user.id]), ('requester_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_request_manager" model="ir.rule">
        <field name="name">Approval managers see all indexed requests</field>
        <field name="model_id" ref="model_approval_center_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
    </record>
</odoo>
