<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_approval_dashboard" model="ir.module.category">
            <field name="name">Approval Dashboard</field>
            <field name="description">Central approval dashboard permissions</field>
            <field name="sequence">35</field>
        </record>

        <record id="group_approval_dashboard_manager" model="res.groups">
            <field name="name">Approval Dashboard Administrator</field>
            <field name="category_id" ref="module_category_approval_dashboard"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids"
                   eval="[(4, ref('dex_approval_dashboard.group_approval_dashboard_manager'))]"/>
        </record>
    </data>
</odoo>
