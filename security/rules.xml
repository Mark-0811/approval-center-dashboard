<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_dashboard_item_user" model="ir.rule">
            <field name="name">Approval requests visible to requester or responsible user</field>
            <field name="model_id" ref="model_dex_approval_dashboard_item"/>
            <field name="domain_force">['|', ('requester_user_id', '=', user.id), ('assigned_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_dashboard_item_manager" model="ir.rule">
            <field name="name">Approval dashboard administrators see all requests</field>
            <field name="model_id" ref="model_dex_approval_dashboard_item"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_approval_dashboard_manager'))]"/>
        </record>
    </data>
</odoo>
