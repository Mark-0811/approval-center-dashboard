<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_approval_dashboard_item_tree" model="ir.ui.view">
            <field name="name">dex_approval_dashboard.item.tree</field>
            <field name="model">dex_approval_dashboard.item</field>
            <field name="arch" type="xml">
                <tree create="0" edit="0" delete="0"
                      decoration-warning="normalized_status == 'pending'"
                      decoration-success="normalized_status == 'approved'"
                      decoration-danger="normalized_status == 'rejected'"
                      decoration-muted="normalized_status == 'cancelled'">
                    <field name="request_date"/>
                    <field name="name"/>
                    <field name="category_id"/>
                    <field name="approval_type_id"/>
                    <field name="requester_name"/>
                    <field name="assigned_user_ids" widget="many2many_tags"/>
                    <field name="normalized_status" widget="badge"/>
                </tree>
            </field>
        </record>

        <record id="view_approval_dashboard_item_form" model="ir.ui.view">
            <field name="name">dex_approval_dashboard.item.form</field>
            <field name="model">dex_approval_dashboard.item</field>
            <field name="arch" type="xml">
                <form string="Approval Request" create="0" edit="0" delete="0">
                    <header>
                        <button name="action_open_source" type="object" string="Open Original Request" class="btn-primary"/>
                        <field name="normalized_status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title"><h1><field name="name"/></h1></div>
                        <group>
                            <group>
                                <field name="category_id"/>
                                <field name="approval_type_id"/>
                            </group>
                            <group>
                                <field name="request_date"/>
                                <field name="requester_name"/>
                                <field name="assigned_user_ids" widget="many2many_tags"/>
                                <field name="last_sync"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_approval_dashboard_item_search" model="ir.ui.view">
            <field name="name">dex_approval_dashboard.item.search</field>
            <field name="model">dex_approval_dashboard.item</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="approval_type_id"/>
                    <field name="category_id"/>
                    <field name="requester_name"/>
                    <field name="assigned_user_ids"/>
                    <filter name="pending" string="Pending" domain="[('normalized_status', '=', 'pending')]"/>
                    <filter name="approved" string="Approved" domain="[('normalized_status', '=', 'approved')]"/>
                    <filter name="rejected" string="Rejected" domain="[('normalized_status', '=', 'rejected')]"/>
                    <filter name="cancelled" string="Cancelled" domain="[('normalized_status', '=', 'cancelled')]"/>
                    <separator/>
                    <filter name="my_requests" string="My Requests" domain="[('requester_user_id', '=', uid)]"/>
                    <filter name="assigned_to_me" string="Assigned to Me" domain="[('assigned_user_ids', 'in', [uid])]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                        <filter name="group_type" string="Approval Function" context="{'group_by': 'approval_type_id'}"/>
                        <filter name="group_status" string="Status" context="{'group_by': 'normalized_status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_approval_dashboard_items" model="ir.actions.act_window">
            <field name="name">Approval Requests</field>
            <field name="res_model">dex_approval_dashboard.item</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{
                'search_default_pending': 1,
                'search_default_assigned_to_me': 1,
                'search_default_group_category': 1,
            }</field>
        </record>

        <record id="action_approval_dashboard_my_items" model="ir.actions.act_window">
            <field name="name">My Approvals</field>
            <field name="res_model">dex_approval_dashboard.item</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="context">{
                'search_default_pending': 1,
                'search_default_assigned_to_me': 1,
                'search_default_group_category': 1,
            }</field>
        </record>
    </data>
</odoo>
