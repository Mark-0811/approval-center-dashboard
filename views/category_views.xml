<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_approval_dashboard_category_tree" model="ir.ui.view">
            <field name="name">dex_approval_dashboard.category.tree</field>
            <field name="model">dex_approval_dashboard.category</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="color" widget="color_picker"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_approval_dashboard_category_form" model="ir.ui.view">
            <field name="name">dex_approval_dashboard.category.form</field>
            <field name="model">dex_approval_dashboard.category</field>
            <field name="arch" type="xml">
                <form string="Approval Category">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="color" widget="color_picker"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Approval Functions">
                                <field name="approval_type_ids" readonly="1">
                                    <tree>
                                        <field name="sequence"/>
                                        <field name="name"/>
                                        <field name="model_name"/>
                                        <field name="active"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_approval_dashboard_categories" model="ir.actions.act_window">
            <field name="name">Categories</field>
            <field name="res_model">dex_approval_dashboard.category</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
